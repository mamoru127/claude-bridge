<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.codex-app-server</string>

  <!-- ブリッジと Codex アプリが共有する app-server。`unix://` は CODEX_HOME 配下の
       app-server-control/app-server-control.sock を作る。アプリはこのソケットが在り、
       かつ CODEX_APP_SERVER_USE_LOCAL_DAEMON=1 のときだけ、自前の子プロセスを立てずに
       ここへ繋ぐ。両者が同じプロセスを使うと、ブリッジが始めたターンの実行中表示が
       アプリ側にも出る。スレッドの状態はそれを走らせているプロセスのメモリにしかない。

       実行ファイルは Codex アプリ内蔵のものを使う。アプリはソケット越しに得た
       app-server のバージョンを見て接続可否を決めるため、アプリと揃える。
       また、内蔵ブラウザのmacOS署名確認が peer/parent/grandparent を検査するため、
       app-server はOpenAI署名済みの同梱Nodeを親にして起動する。
       アプリ更新による実行ファイルの差し替えは親プロセスが見張り、見つけ次第
       app-server を落として KeepAlive の再起動で新しい実行ファイルへ入れ替える。 -->
  <key>ProgramArguments</key>
  <array>
    <string>__CODEX_BUNDLED_NODE__</string>
    <string>__CODEX_APP_SERVER_PARENT_WRAPPER__</string>
    <string>__CODEX_BUNDLED_CLI__</string>
    <string>app-server</string>
    <string>--listen</string>
    <string>unix://</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/codex-app-server/app-server.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/codex-app-server/app-server.log</string>
</dict>
</plist>
