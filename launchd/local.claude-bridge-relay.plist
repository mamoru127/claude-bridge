<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.claude-bridge-relay</string>

  <!-- Codex アプリと共有 app-server の間の中継。作業中の Claude のスレッドへ届いた指示を
       ブリッジへ知らせる。アプリはこのソケットへ繋ぐため、止まるとアプリが app-server へ
       届かなくなる。ブリッジとは別のジョブにして、ブリッジの再起動に巻き込まない。 -->
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON_BIN__</string>
    <string>-m</string>
    <string>claude_bridge.app_relay</string>
    <string>--listen</string>
    <string>__RELAY_SOCKET__</string>
    <string>--upstream</string>
    <string>__APP_SERVER_SOCKET__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__WORKING_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>2</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/claude-bridge/relay.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/claude-bridge/relay.log</string>
</dict>
</plist>
